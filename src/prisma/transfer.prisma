model Transfer {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceBookId String?
  targetBookId String?

  targetBook Book? @relation("TransferTargetBook", fields: [targetBookId], references: [id], onDelete: SetNull)
  sourceBook Book? @relation("TransferSourceBook", fields: [sourceBookId], references: [id], onDelete: SetNull)

  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @default(now())
  remark String?

  sourceTransactionId String? @unique
  targetTransactionId String? @unique

  sourceTransaction Transaction? @relation("TransferSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: SetNull)
  targetTransaction Transaction? @relation("TransferTargetTransaction", fields: [targetTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sourceBookId])
  @@index([targetBookId])
  @@index([date])
}
