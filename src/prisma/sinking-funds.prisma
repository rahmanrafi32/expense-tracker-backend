model SinkingFund {
  id           String               @id @default(uuid())
  bookId       String
  book         Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal              @db.Decimal(14, 2)
  savedAmount  Decimal              @default(0) @db.Decimal(14, 2)
  deadline     DateTime
  deposits     SinkingFundDeposit[]

  categoryId String?
  category   Category? @relation("SinkingFundCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  recurringExpenseId String?             @unique
  recurringExpense   ReccuringExpenses?  @relation("RecurringExpenseFund", fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  allocations        ReserveAllocation[]
  cycleStartedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}

model SinkingFundDeposit {
  id            String      @id @default(uuid())
  sinkingFundId String
  sinkingFund   SinkingFund @relation(fields: [sinkingFundId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(14, 2)
  note          String?
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sinkingFundId])
}
