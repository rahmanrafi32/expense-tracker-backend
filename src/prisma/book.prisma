model Book {
  id                      String              @id @default(uuid())
  name                    String
  userId                  String
  bookTotalAmount         Decimal             @default(0.00) @db.Decimal(14, 2)
  monthlyIncome           Decimal             @default(0.00) @db.Decimal(14, 2)
  expectedMonthlyExpenses Decimal             @default(0.00) @db.Decimal(14, 2)
  type                    BookType            @default(OPERATING)
  currency                String              @default("BDT")
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  transactions            Transaction[]
  commitments             ReccuringExpenses[]
  goals                   Goal[]
  emergencyEntries        EmergencyFund[]
  sinkingFunds            SinkingFund[]

  outgoingTransfers Transfer[] @relation("TransferSourceBook")
  incomingTransfers Transfer[] @relation("TransferTargetBook")
}

enum BookType {
  OPERATING
  ESCROW
}
