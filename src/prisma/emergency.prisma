model EmergencyFund {
  id     String @id @default(uuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  paymentMethodId String
  paymentMethod   PaymentMethod @relation("EmergencyFundPaymentMethod", fields: [paymentMethodId], references: [id], onDelete: Restrict)

  type      EmergencyFundType
  amount    Decimal           @db.Decimal(14, 2)
  remark    String
  date      DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  transaction Transaction? @relation("EmergencyFundTransaction")

  @@index([bookId])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([date])
}

enum EmergencyFundType {
  WITHDRAWAL
  REPAYMENT
}
