model ReccuringExpenses {
  id              String           @id @default(uuid())
  bookId          String
  book            Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name            String
  amount          Decimal          @db.Decimal(14, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod?   @relation("RecurringExpensePaymentMethod", fields: [paymentMethodId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?        @relation("RecurringExpenseCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  frequency       ExpenseFrequency
  nextDueDate     DateTime
  status          ExpenseStatus    @default(UNPAID)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  transactions Transaction[] @relation("RecurringExpenseTransaction")

  sinkingFund SinkingFund? @relation("RecurringExpenseFund")

  @@index([bookId])
  @@index([nextDueDate])
}

enum ExpenseFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum ExpenseStatus {
  PAID
  UNPAID
  OVERDUE
}
