model Transaction {
  id     String          @id @default(uuid())
  bookId String
  book   Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type   TransactionType
  date   DateTime
  amount Decimal         @default(0.00) @db.Decimal(14, 2)
  remark String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  emergencyFundId String?        @unique
  emergencyFund   EmergencyFund? @relation("EmergencyFundTransaction", fields: [emergencyFundId], references: [id], onDelete: SetNull)

  recurringExpenseId String?
  recurringExpense   ReccuringExpenses? @relation("RecurringExpenseTransaction", fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  allocationBatch    AllocationBatch?

  loanId                 String?
  loan                   Loan?                   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanRepayment          LoanRepayment?
  allocationConsumptions AllocationConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId, date, createdAt, id])
  @@index([loanId])
}

enum TransactionType {
  INCOME
  EXPENSE
}
